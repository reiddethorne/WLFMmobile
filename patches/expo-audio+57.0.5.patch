diff --git a/node_modules/expo-audio/ios/LiveStreamRecoveryState.swift b/node_modules/expo-audio/ios/LiveStreamRecoveryState.swift
new file mode 100644
index 0000000..4162d6c
--- /dev/null
+++ b/node_modules/expo-audio/ios/LiveStreamRecoveryState.swift
@@ -0,0 +1,62 @@
+struct LiveStreamRecoveryState {
+  enum PlaybackIntent {
+    case paused
+    case playing
+  }
+
+  enum Connectivity {
+    case unknown
+    case available
+    case unavailable
+  }
+
+  enum SourceFreshness {
+    case fresh
+    case stale
+  }
+
+  enum Event {
+    case playRequested
+    case pauseRequested
+    case networkAvailable
+    case networkUnavailable
+    case sourceExpired
+    case sourceReplaced
+    case playbackStarted
+  }
+
+  private(set) var playbackIntent = PlaybackIntent.paused
+  private(set) var connectivity = Connectivity.unknown
+  private(set) var sourceFreshness = SourceFreshness.fresh
+
+  var intendsToPlay: Bool {
+    playbackIntent == .playing
+  }
+
+  @discardableResult
+  mutating func transition(_ event: Event) -> Bool {
+    switch event {
+    case .playRequested:
+      playbackIntent = .playing
+    case .pauseRequested:
+      playbackIntent = .paused
+    case .networkAvailable:
+      connectivity = .available
+    case .networkUnavailable:
+      connectivity = .unavailable
+      sourceFreshness = .stale
+    case .sourceExpired:
+      sourceFreshness = .stale
+    case .sourceReplaced:
+      sourceFreshness = connectivity == .unavailable ? .stale : .fresh
+    case .playbackStarted:
+      if connectivity != .unavailable {
+        sourceFreshness = .fresh
+      }
+    }
+
+    return playbackIntent == .playing &&
+      connectivity != .unavailable &&
+      sourceFreshness == .stale
+  }
+}
